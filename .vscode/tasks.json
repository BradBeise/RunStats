{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build RunStats",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/RunStats.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test RunStats models",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/RunStats.Tests/RunStats.Tests.csproj", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
